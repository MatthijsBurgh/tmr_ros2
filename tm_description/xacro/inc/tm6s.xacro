<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find tm_description)/xacro/macro.inertial.xacro" />

  <xacro:macro name="tm_links" params="prefix physical_params">

    <link name="${prefix}link_0">
        <visual>
          <geometry>
            <mesh filename="package://tm_description/meshes/tm6s/visual/link0.dae" />
          </geometry>
        </visual>
        <collision>
          <geometry>
            <mesh filename="package://tm_description/meshes/tm6s/collision/link0_c.stl" />
          </geometry>
        </collision>
    <!--inertial-->
        <xacro:cylinder_inertial_z radius="${physical_params['link_0']['radius']}" length="${physical_params['link_0']['length']}" mass="${physical_params['link_0']['mass']}">
          <origin rpy="0.000000 0.000000 0.000000" xyz="0.000000 0.000000 0.000000" />
        </xacro:cylinder_inertial_z>
      </link>

    <link name="${prefix}link_1">
        <visual>
          <geometry>
            <mesh filename="package://tm_description/meshes/tm6s/visual/link1.dae" />
          </geometry>
        </visual>
        <collision>
          <geometry>
            <mesh filename="package://tm_description/meshes/tm6s/collision/link1_c.stl" />
          </geometry>
        </collision>
        <inertial>
          <origin rpy="0.000000 0.000000 0.000000" xyz="0.000000 0.000000 0.000000" />
          <mass value="${physical_params['link_1']['mass']}" />
          <inertia ixx="${physical_params['link_1']['ixx']}" ixy="0.0" ixz="0.0" iyy="${physical_params['link_1']['iyy']}" iyz="0.0" izz="${physical_params['link_1']['izz']}" />
        </inertial>
      </link>

    <link name="${prefix}link_2">
        <visual>
          <geometry>
            <mesh filename="package://tm_description/meshes/tm6s/visual/link2.dae" />
          </geometry>
        </visual>
        <collision>
          <geometry>
            <mesh filename="package://tm_description/meshes/tm6s/collision/link2_c.stl" />
          </geometry>
        </collision>
        <inertial>
          <origin rpy="0.000000 0.000000 0.000000" xyz="0.000000 0.000000 0.000000" />
          <mass value="${physical_params['link_2']['mass']}" />
          <inertia ixx="${physical_params['link_2']['ixx']}" ixy="0.0" ixz="0.0" iyy="${physical_params['link_2']['iyy']}" iyz="0.0" izz="${physical_params['link_2']['izz']}" />
        </inertial>
      </link>

    <link name="${prefix}link_3">
        <visual>
          <geometry>
            <mesh filename="package://tm_description/meshes/tm6s/visual/link3.dae" />
          </geometry>
        </visual>
        <collision>
          <geometry>
            <mesh filename="package://tm_description/meshes/tm6s/collision/link3_c.stl" />
          </geometry>
        </collision>
        <inertial>
          <origin rpy="0.000000 0.000000 0.000000" xyz="0.000000 0.000000 0.000000" />
          <mass value="${physical_params['link_3']['mass']}" />
          <inertia ixx="${physical_params['link_3']['ixx']}" ixy="0.0" ixz="0.0" iyy="${physical_params['link_3']['iyy']}" iyz="0.0" izz="${physical_params['link_3']['izz']}" />
        </inertial>
      </link>

    <link name="${prefix}link_4">
        <visual>
          <geometry>
            <mesh filename="package://tm_description/meshes/tm6s/visual/link4.dae" />
          </geometry>
        </visual>
        <collision>
          <geometry>
            <mesh filename="package://tm_description/meshes/tm6s/collision/link4_c.stl" />
          </geometry>
        </collision>
        <inertial>
          <origin rpy="0.000000 0.000000 0.000000" xyz="0.000000 0.000000 0.000000" />
          <mass value="${physical_params['link_4']['mass']}" />
          <inertia ixx="${physical_params['link_4']['ixx']}" ixy="0.0" ixz="0.0" iyy="${physical_params['link_4']['iyy']}" iyz="0.0" izz="${physical_params['link_4']['izz']}" />
        </inertial>
      </link>

    <link name="${prefix}link_5">
        <visual>
          <geometry>
            <mesh filename="package://tm_description/meshes/tm6s/visual/link5.dae" />
          </geometry>
        </visual>
        <collision>
          <geometry>
            <mesh filename="package://tm_description/meshes/tm6s/collision/link5_c.stl" />
          </geometry>
        </collision>
        <inertial>
          <origin rpy="0.000000 0.000000 0.000000" xyz="0.000000 0.000000 0.000000" />
          <mass value="${physical_params['link_5']['mass']}" />
          <inertia ixx="${physical_params['link_5']['ixx']}" ixy="0.0" ixz="0.0" iyy="${physical_params['link_5']['iyy']}" iyz="0.0" izz="${physical_params['link_5']['izz']}" />
        </inertial>
      </link>

    <link name="${prefix}link_6">
        <visual>
          <geometry>
            <mesh filename="package://tm_description/meshes/tm6s/visual/link6.dae" />
          </geometry>
        </visual>
        <collision>
          <geometry>
            <mesh filename="package://tm_description/meshes/tm6s/collision/link6_c.stl" />
          </geometry>
        </collision>
        <inertial>
          <origin rpy="0.000000 0.000000 0.000000" xyz="0.000000 0.000000 0.000000" />
          <mass value="${physical_params['link_6']['mass']}" />
          <inertia ixx="${physical_params['link_6']['ixx']}" ixy="0.0" ixz="0.0" iyy="${physical_params['link_6']['iyy']}" iyz="0.0" izz="${physical_params['link_6']['izz']}" />
        </inertial>
      </link>

  </xacro:macro>

</robot>
